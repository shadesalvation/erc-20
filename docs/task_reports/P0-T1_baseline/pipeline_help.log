usage: s_seir_pipeline.py [-h] [-o OUTPUT] [--text-output TEXT_OUTPUT]
                          [--semantic-fact-ir-output SEMANTIC_FACT_IR_OUTPUT]
                          [--semantic-fact-ir-text-output SEMANTIC_FACT_IR_TEXT_OUTPUT]
                          [--semantic-fact-c-output SEMANTIC_FACT_C_OUTPUT]
                          [--semantic-fact-cfg-text-output SEMANTIC_FACT_CFG_TEXT_OUTPUT]
                          [--semantic-fact-cfg-dot-dir SEMANTIC_FACT_CFG_DOT_DIR]
                          [--solidity-atomic-output SOLIDITY_ATOMIC_OUTPUT]
                          [--debug-output DEBUG_OUTPUT]
                          [--cfg-dot-dir CFG_DOT_DIR]
                          [--llm-assembly-output LLM_ASSEMBLY_OUTPUT]
                          [--llm-assembly-text-output LLM_ASSEMBLY_TEXT_OUTPUT]
                          [--llm-assembly-compact-output LLM_ASSEMBLY_COMPACT_OUTPUT]
                          [--llm-assembly-compact-text-output LLM_ASSEMBLY_COMPACT_TEXT_OUTPUT]
                          [--solidity-like-output SOLIDITY_LIKE_OUTPUT]
                          [--branch-preprocessed-output BRANCH_PREPROCESSED_OUTPUT]
                          [--branch-report-output BRANCH_REPORT_OUTPUT]
                          [--no-branch-preprocess] [--solc-bin SOLC_BIN]
                          [--slither-bin SLITHER_BIN] [--workdir WORKDIR]
                          source

positional arguments:
  source

options:
  -h, --help            show this help message and exit
  -o OUTPUT, --output OUTPUT
  --text-output TEXT_OUTPUT
  --semantic-fact-ir-output SEMANTIC_FACT_IR_OUTPUT, --semantic-facts-output SEMANTIC_FACT_IR_OUTPUT, --semantic-ir-output SEMANTIC_FACT_IR_OUTPUT
                        Function-level Semantic Fact IR JSON. The former
                        semantic-facts/semantic-ir flags are compatibility
                        aliases.
  --semantic-fact-ir-text-output SEMANTIC_FACT_IR_TEXT_OUTPUT, --semantic-ir-text-output SEMANTIC_FACT_IR_TEXT_OUTPUT
                        Human-auditable Semantic Fact IR text view.
  --semantic-fact-c-output SEMANTIC_FACT_C_OUTPUT, --sfir-c-output SEMANTIC_FACT_C_OUTPUT
                        C-like, basic-block SFIR projection derived only from
                        final SFIR.
  --semantic-fact-cfg-text-output SEMANTIC_FACT_CFG_TEXT_OUTPUT
                        Human-readable Fact CFG with high-level SFIR at each
                        block.
  --semantic-fact-cfg-dot-dir SEMANTIC_FACT_CFG_DOT_DIR
                        Directory for one semantic Fact CFG DOT file per
                        function.
  --solidity-atomic-output SOLIDITY_ATOMIC_OUTPUT
                        Optional audit output for the transient Solidity
                        atomic-operation table.
  --debug-output DEBUG_OUTPUT
                        Optional full analysis output including
                        MemorySSA/SinkResolver query traces.
  --cfg-dot-dir CFG_DOT_DIR
  --llm-assembly-output LLM_ASSEMBLY_OUTPUT
  --llm-assembly-text-output LLM_ASSEMBLY_TEXT_OUTPUT
  --llm-assembly-compact-output LLM_ASSEMBLY_COMPACT_OUTPUT
  --llm-assembly-compact-text-output LLM_ASSEMBLY_COMPACT_TEXT_OUTPUT
  --solidity-like-output SOLIDITY_LIKE_OUTPUT
  --branch-preprocessed-output BRANCH_PREPROCESSED_OUTPUT
  --branch-report-output BRANCH_REPORT_OUTPUT
  --no-branch-preprocess
  --solc-bin SOLC_BIN
  --slither-bin SLITHER_BIN
  --workdir WORKDIR
