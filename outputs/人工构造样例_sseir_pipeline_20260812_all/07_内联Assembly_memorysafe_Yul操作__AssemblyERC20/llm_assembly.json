      "function_source": {
        "src": "1778:841:0",
        "text": "function sumSkipping(uint256[] memory values) external pure returns (uint256 total) {\n        assembly {\n            function addOrLeave(a, b) -> r {\n                if gt(a, not(b)) {\n                    r := 0\n                    leave\n                }\n                r := add(a, b)\n            }\n\n            let len := mload(values)\n            let ptr := add(values, 0x20)\n            for { let i := 0 } lt(i, len) { i := add(i, 1) } {\n                let v := mload(add(ptr, mul(i, 0x20)))\n                if eq(v, 0) { continue }\n                if gt(v, 1000000) { break }\n\n                switch and(v, 1)\n                case 0 {\n                    total := addOrLeave(total, v)\n                }\n                default {\n                    total := addOrLeave(total, mul(v, 2))\n                }\n            }\n        }\n    }"
      },
