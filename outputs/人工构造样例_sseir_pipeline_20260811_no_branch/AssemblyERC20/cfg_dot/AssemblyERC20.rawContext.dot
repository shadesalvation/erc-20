  "bb_sol_slither_n7" [shape="box", style="rounded,filled", fontname="Consolas", fontsize="10", color="#3f8f42", fillcolor="#e9ffe8", peripheries="2", label="bb_sol_slither_n7\\nkind=solidity\\nslither_node=7\\n(who,value,size,gasLeft)\\nterm=Return: (who,value,size,gasLeft)"];
  "bb_asm4_n0" [shape="box", style="rounded,filled", fontname="Consolas", fontsize="10", color="#c48700", fillcolor="#fff4d6", label="bb_asm4_n0\\nkind=yul\\nassembly_block=4\\nyul_node=0\\nentry\\nterm=YulNode: entry"];
  "bb_asm4_n1" [shape="box", style="rounded,filled", fontname="Consolas", fontsize="10", color="#c48700", fillcolor="#fff4d6", label="bb_asm4_n1\\nkind=yul\\nassembly_block=4\\nyul_node=1\\nexit\\nterm=YulNode: exit"];
  "bb_asm4_n2" [shape="box", style="rounded,filled", fontname="Consolas", fontsize="10", color="#c48700", fillcolor="#fff4d6", label="bb_asm4_n2\\nkind=yul\\nassembly_block=4\\nyul_node=2\\nstmts=asm_s_1\\nasm_s_1: who := caller()\\nterm=YulNode: who := caller()"];
  "bb_asm4_n3" [shape="box", style="rounded,filled", fontname="Consolas", fontsize="10", color="#c48700", fillcolor="#fff4d6", label="bb_asm4_n3\\nkind=yul\\nassembly_block=4\\nyul_node=3\\nstmts=asm_s_2\\nasm_s_2: value := callvalue()\\nterm=YulNode: value := callvalue()"];
  "bb_asm4_n4" [shape="box", style="rounded,filled", fontname="Consolas", fontsize="10", color="#c48700", fillcolor="#fff4d6", label="bb_asm4_n4\\nkind=yul\\nassembly_block=4\\nyul_node=4\\nstmts=asm_s_3\\nasm_s_3: size := calldatasize()\\nterm=YulNode: size := calldatasize()"];
  "bb_asm4_n5" [shape="box", style="rounded,filled", fontname="Consolas", fontsize="10", color="#c48700", fillcolor="#fff4d6", label="bb_asm4_n5\\nkind=yul\\nassembly_block=4\\nyul_node=5\\nstmts=asm_s_4\\nasm_s_4: gasLeft := gas()\\nterm=YulNode: gasLeft := gas()"];
  "bb_asm4_n0" -> "bb_asm4_n2" [fontname="Consolas", fontsize="9", label="next", color="#586069"];
