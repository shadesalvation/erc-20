digraph "AssemblyERC20.rawContext" {
  graph [rankdir=TB, bgcolor="#ffffff", labelloc=t, fontsize=14, fontname="Consolas", label="AssemblyERC20.rawContext()"];
  node [fontname="Consolas"];
