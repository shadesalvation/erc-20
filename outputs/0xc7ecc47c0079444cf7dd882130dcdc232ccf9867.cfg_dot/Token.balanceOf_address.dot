digraph "Token.balanceOf_address" {
  graph [rankdir=TB, bgcolor="#ffffff", labelloc=t, fontsize=14, fontname="Consolas", label="Token.balanceOf(address)"];
  node [fontname="Consolas"];
  edge [fontname="Consolas"];
  "__cfg_notes" [shape=note, style="filled", fillcolor="#f6f8fa", color="#d0d7de", fontsize="9", label="CFG notes:\nfunction_level_cfg_from_slither\nassembly_subgraph_embedded_from_assembly_ast_cfg\nslither_assembly_nodes_replaced_by_local_yul_cfg\nslither_nodes=2\nassembly_blocks=0\nassembly_edge_policy=slither_predecessors_to_yul_entry_and_yul_exit_to_slither_successors"];
  "bb_sol_slither_n0" [shape="box", style="rounded,filled", fontname="Consolas", fontsize="10", color="#3574b7", fillcolor="#e8f2ff", label="bb_sol_slither_n0\\nkind=solidity\\nslither_node=0\\nentrypoint\\nterm=Fallthrough: entrypoint"];
  "bb_sol_slither_n1" [shape="box", style="rounded,filled", fontname="Consolas", fontsize="10", color="#3f8f42", fillcolor="#e9ffe8", peripheries="2", label="bb_sol_slither_n1\\nkind=solidity\\nslither_node=1\\nUbLX[_account]\\nterm=Return: UbLX[_account]"];
  "bb_sol_slither_n0" -> "bb_sol_slither_n1" [fontname="Consolas", fontsize="9", label="fallthrough", color="#586069"];
}
